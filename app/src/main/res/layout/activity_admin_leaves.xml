<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <LinearLayout style="@style/ScreenHeader">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnBack"
                style="@style/IconButton"
                android:gravity="center"
                android:text="‹"
                android:textColor="@color/white"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                style="@style/HeaderTitle"
                android:text="@string/admin_leaves" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginStart="52dp"
            android:text="Acceptez ou refusez les demandes reçues"
            android:textColor="#CFE3FF"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Filtres -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="18dp"
        android:paddingTop="14dp">

        <TextView
            android:id="@+id/filterAll"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/chip_soft"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Tous"
            android:textColor="@color/chip_text_selector"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/filterPending"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/chip_soft"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="En attente"
            android:textColor="@color/chip_text_selector"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/filterApproved"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/chip_soft"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Acceptés"
            android:textColor="@color/chip_text_selector"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/filterRejected"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/chip_soft"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Refusés"
            android:textColor="@color/chip_text_selector"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingHorizontal="18dp"
        android:paddingTop="12dp">

        <TextView
            android:id="@+id/leavesCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 demande"
            android:textColor="@color/text_medium"
            android:textSize="13sp"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/leavesList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="24dp" />

        <TextView
            android:id="@+id/emptyLeaves"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:elevation="4dp"
            android:gravity="center"
            android:padding="26dp"
            android:text="Aucune demande dans cette catégorie"
            android:textColor="@color/text_light"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>

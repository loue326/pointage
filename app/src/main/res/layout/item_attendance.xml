<?xml version="1.0" encoding="utf-8"?>
<!-- Une journée dans l'historique -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_card"
    android:elevation="5dp"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Titre : date + statut -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/circle_blue"
            android:gravity="center"
            android:text="📅"
            android:textSize="18sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/histDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2026-01-15"
                android:textColor="@color/text_dark"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/histWorked"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="8h00 de travail"
                android:textColor="@color/text_medium"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/histStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/chip_approved"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="Terminé"
            android:textColor="@color/success"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="12dp"
        android:background="@color/divider" />

    <!-- Arrivée / Sortie -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/histArrival"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌅 08:02"
                android:textColor="@color/success"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Arrivée"
                android:textColor="@color/text_light"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/histExit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌙 16:35"
                android:textColor="@color/danger"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sortie"
                android:textColor="@color/text_light"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Pauses de la journée -->
    <LinearLayout
        android:id="@+id/histBreaksContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical"
        android:visibility="gone" />

</LinearLayout>

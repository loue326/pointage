<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F1930">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ADMIN DASHBOARD"
            android:textColor="#FFFFFF"
            android:textSize="25sp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="20dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Gestion des employés"
            android:textColor="#FF8800"
            android:textSize="20sp"
            android:textStyle="bold"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1B2942"
            android:padding="15dp"
            android:layout_marginTop="10dp">

            <TextView
                android:id="@+id/txtTotalEmployees"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Total employés : 0"
                android:textColor="#FFFFFF"
                android:textSize="17sp"/>

            <TextView
                android:id="@+id/txtPresent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Présents : 0"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:paddingTop="10dp"/>

            <TextView
                android:id="@+id/txtAbsent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Absents : 0"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:paddingTop="10dp"/>

            <TextView
                android:id="@+id/txtPending"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Congés en attente : 0"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:paddingTop="10dp"/>

        </LinearLayout>

        <Button
            android:id="@+id/btnEmployees"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Liste des employés"
            android:layout_marginTop="15dp"
            android:backgroundTint="#FF8800"
            android:textColor="#FFFFFF"/>

        <Button
            android:id="@+id/btnLeaves"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Demandes de congés"
            android:backgroundTint="#FF8800"
            android:textColor="#FFFFFF"/>

        <Button
            android:id="@+id/btnAttendance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Consulter les pointages"
            android:backgroundTint="#FF8800"
            android:textColor="#FFFFFF"/>

        <Button
            android:id="@+id/btnBreaks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Consulter les pauses"
            android:backgroundTint="#FF8800"
            android:textColor="#FFFFFF"/>

        <TextView
            android:id="@+id/txtSectionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Bienvenue Administrateur"
            android:textColor="#FF8800"
            android:textSize="20sp"
            android:textStyle="bold"
            android:paddingTop="25dp"
            android:paddingBottom="15dp"/>

        <LinearLayout
            android:id="@+id/contentContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"/>

    </LinearLayout>

</ScrollView>

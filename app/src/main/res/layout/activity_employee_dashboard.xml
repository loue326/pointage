<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F1930">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ESPACE EMPLOYÉ"
            android:textColor="#FFFFFF"
            android:textSize="25sp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="20dp"/>

        <TextView
            android:id="@+id/txtWelcome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Bienvenue"
            android:textColor="#FF8800"
            android:textSize="20sp"
            android:gravity="center"
            android:padding="12dp"/>

        <TextView
            android:id="@+id/txtStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Statut : Non pointé"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:gravity="center"
            android:background="#1B2942"
            android:padding="20dp"/>

        <TextView
            android:id="@+id/txtTimer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="10:00"
            android:textColor="#FF8800"
            android:textSize="38sp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="20dp"/>

        <Button
            android:id="@+id/btnCheckIn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pointer mon arrivée"
            android:backgroundTint="#FF8800"
            android:textColor="#FFFFFF"/>

        <Button
            android:id="@+id/btnStartBreak"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Commencer ma pause"
            android:backgroundTint="#FF8800"
            android:textColor="#FFFFFF"
            android:layout_marginTop="10dp"/>

        <Button
            android:id="@+id/btnEndBreak"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Reprendre le travail"
            android:backgroundTint="#FF8800"
            android:textColor="#FFFFFF"
            android:layout_marginTop="10dp"/>

        <Button
            android:id="@+id/btnCheckOut"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pointer ma sortie"
            android:backgroundTint="#FF8800"
            android:textColor="#FFFFFF"
            android:layout_marginTop="10dp"/>

        <Button
            android:id="@+id/btnLeaveRequests"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mes demandes de congé"
            android:backgroundTint="#FF8800"
            android:textColor="#FFFFFF"
            android:layout_marginTop="10dp"/>

        <Button
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Déconnexion"
            android:backgroundTint="#B3261E"
            android:textColor="#FFFFFF"
            android:layout_marginTop="20dp"/>

    </LinearLayout>

</ScrollView>
